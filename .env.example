# Copy to .env and fill (never commit .env)

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
FLASK_SECRET_KEY=change-me

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Kie.ai — GPT Image 2 / Nano Banana for admin book generator
# https://kie.ai/api-key
KIE_API_KEY=
# Optional overrides:
# KIE_I2I_MODEL=gpt-image-2-image-to-image
# KIE_NANOBANANA_MODEL=google/nano-banana
# KIE_ASPECT_RATIO=2:3
# KIE_RESOLUTION=1K
# Posters (A3) only — does not change book page resolution:
# KIE_POSTER_RESOLUTION=2K
# KIE_POSTER_ASPECT=3:4
# KIE_POSTER_LANDSCAPE_ASPECT=4:3
# Approx admin cost estimates (USD per image, display only):
# COST_CHATGPT_USD=0.03
# COST_NANOBANANA_USD=0.04
# COST_POSTER_CHATGPT_USD=0.06
# COST_POSTER_NANOBANANA_USD=0.08
# COST_USD_TO_EGP=50

# Paymob Egypt (test keys from dashboard)
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
# Required: Settings → Payment Integrations → Card (Test)
PAYMOB_INTEGRATION_ID=
# Optional but recommended for Egypt: Mobile Wallet integration ID
PAYMOB_INTEGRATION_ID_WALLET=
# Or list both: PAYMOB_INTEGRATION_IDS=cardId,walletId

# Public site URL for callbacks (use ngrok/tunnel in local dev)
APP_URL=http://127.0.0.1:5001

# Google OAuth (optional — hide Google button if empty)
# Create Web client in Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URI: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

BOOK_PACK_PRICE_EGP=49
BOOK_PACK_CREDITS=10
FREE_BOOKS_PER_MONTH=3

# Sales landing page (/) — WhatsApp order funnel (change anytime, restart app)
SALES_WHATSAPP=01555119079
SALES_PRICE_EGP=350
SALES_COMPARE_AT_EGP=699
# Optional prefilled WhatsApp message (URL-encoded by the server)
SALES_WHATSAPP_MESSAGE=مرحباً لونّي، عايز أطلب كتاب تلوين مخصص. اسم الطفل: ... وجاهز أبعت الصورة.

# Resend — email alerts for new /order bookings
# https://resend.com/api-keys
RESEND_API_KEY=
# After verifying your domain at resend.com/domains, use e.g.:
# RESEND_FROM=Lony <orders@lony.ink>
RESEND_FROM=Lony <onboarding@resend.dev>
RESEND_NOTIFY_TO=atpfreelancer@gmail.com,mahaelkhadry@gmail.com

# Evolution API — WhatsApp confirmation to customer after /order
EVOLUTION_API_URL=https://evolution.labeltech.site/message/sendText/201002089079
EVOLUTION_API_KEY=

# Privacy page (/privacy) — optional contact fields shown if set
PRIVACY_UPDATED=13 أغسطس 2026
# PRIVACY_EMAIL=hello@lony.ink
# PRIVACY_ADDRESS=
# PRIVACY_COMMERCIAL_REGISTER=
# PRIVACY_TAX_CARD=
